commands:
  01_install_ffmpeg:
    command: |
      # Install FFmpeg on Amazon Linux 2023 (runs only during deployment, not at runtime)
      if ! command -v ffmpeg &> /dev/null; then
        echo "Installing FFmpeg static binary..."
        cd /tmp
        ARCH=$(uname -m)
        
        if [ "$ARCH" = "x86_64" ]; then
          # Download and install static FFmpeg binary (most reliable for Amazon Linux 2023)
          wget -q --timeout=30 https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
          tar -xf ffmpeg-release-amd64-static.tar.xz
          sudo cp ffmpeg-*-amd64-static/ffmpeg /usr/local/bin/
          sudo cp ffmpeg-*-amd64-static/ffprobe /usr/local/bin/
          sudo chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe
          # Create symlinks to ensure FFmpeg is in PATH
          sudo ln -sf /usr/local/bin/ffmpeg /usr/bin/ffmpeg
          sudo ln -sf /usr/local/bin/ffprobe /usr/bin/ffprobe
          rm -rf ffmpeg-*-amd64-static* ffmpeg-release-amd64-static.tar.xz
          echo "FFmpeg installed successfully"
        else
          echo "Error: Unsupported architecture: $ARCH (expected x86_64)"
          exit 1
        fi
      else
        echo "FFmpeg is already installed"
      fi
    ignoreErrors: false
